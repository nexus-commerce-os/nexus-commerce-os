{
  "name": "@nexus/web",
  "version": "0.0.0",
  "private": true,
  "description": "NEXUS shopper-facing Next.js PWA \u00e2\u20ac\u201d P0.1 scaffold (no features; implemented from P0.2).",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/verify-footer.mjs",
    "start": "next start",
    "lint": "eslint src worker",
    "typecheck": "tsc --noEmit && tsc -p worker --noEmit",
    "deploy:cf": "next build && wrangler deploy",
    "preview:cf": "next build && wrangler dev",
    "verify:footer": "node scripts/verify-footer.mjs"
  },
  "dependencies": {
    "@nexus/ui": "workspace:*",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "wrangler": "^4.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.0"
  }
}
