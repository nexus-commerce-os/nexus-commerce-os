/services/auth/                     @nexus-commerce-os/platform @nexus-commerce-os/cloud-security
/services/catalog/                  @nexus-commerce-os/commerce
/services/affiliate/                @nexus-commerce-os/commerce
/services/search/                   @nexus-commerce-os/commerce
/services/ai/                       @nexus-commerce-os/ai
/services/analytics/                @nexus-commerce-os/data
/services/platform-hello/           @nexus-commerce-os/platform

# Shared packages
