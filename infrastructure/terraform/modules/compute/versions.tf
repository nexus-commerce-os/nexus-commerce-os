# Pins mirror /infrastructure/terraform/versions.tf (canonical).
# tls is required to derive the OIDC provider thumbprint for IRSA.
terraform {
  required_version = ">= 1.7.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.60"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
  }
}
