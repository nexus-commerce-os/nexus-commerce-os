# NEXUS Commerce OS — environment template.
# Copy to `.env.local` (gitignored) and fill in. NEVER commit real secrets —
# secrets are delivered by the external secret store / OIDC at runtime (docs/08 §5).
#
# P0.1 note: this is a SCAFFOLD. No service consumes these variables yet; this file
# documents the intended shape and satisfies turbo.json globalDependencies.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- Observability (OpenTelemetry → collector) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=nexus-local

# --- AWS (local dev uses SSO/OIDC — never hardcode access keys) ---
AWS_REGION=us-east-1
