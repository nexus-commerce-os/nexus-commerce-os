# --- Secrets: NEVER commit. OIDC + external secret stores only. ---
*.env
.env.*
!.env.example
# Blank-valued provider template (provider-access/, artifact 5). `.env.*` above
# would otherwise swallow it silently — a tracked template that cannot be
# committed is worse than none. Values in it must stay blank; real values go
# only into the secret store.
!provider-access/.env.provider.example
*.pem
*.key
*.p12
*.pfx
**/secrets/**
!**/secrets/README.md
*.tfvars
!*.tfvars.example

# --- Terraform ---
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl.bak
tfplan
*.tfplan

# --- Node / pnpm / turbo ---
node_modules/
.pnpm-store/
.turbo/
dist/
build/
out/
coverage/
*.tsbuildinfo
.next/

# --- Containers / build ---
*.tar
sbom/*.json
!sbom/.gitkeep

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Logs ---
*.log
npm-debug.log*
pnpm-debug.log*

# --- Local evidence / scratch artifacts (not part of the repo) ---
stage-a-evidence.txt
stage-*-evidence.txt
*.msi

# --- Next.js generated ---
next-env.d.ts
**/next-env.d.ts
