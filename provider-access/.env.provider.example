# Artifact 5 — Commerce provider environment template
#
# Every value is intentionally blank. Nothing here has a default, and no default
# may be invented for a secret: a placeholder that boots is worse than a failure
# to boot, because it produces confident output from credentials nobody chose.
#
# HOW TO USE
#   Values are entered by the operator directly into the secret store.
#   Do NOT fill this file in and commit it. Do NOT paste values into chat,
#   tickets, screenshots, or log output.
#
# STATUS
#   No connector reads these variables yet. No implementation is authorized.
#   This template exists so that step 6 starts from an agreed surface.
#   Names are defined in SECRET-INVENTORY.md.

# ---------------------------------------------------------------------------
# Which connector is active: impact | cj
# ---------------------------------------------------------------------------
COMMERCE_PROVIDER=

# ---------------------------------------------------------------------------
# Impact — HTTP Basic: Account SID as username, Auth Token as password.
# Created at: User profile -> Settings -> Technical -> API -> Create Access Token
# ---------------------------------------------------------------------------
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
IMPACT_API_BASE_URL=
IMPACT_API_VERSION=
IMPACT_PROGRAM_ID=
IMPACT_CATALOG_ID=
IMPACT_MEDIA_PARTNER_PROPERTY_ID=

# ---------------------------------------------------------------------------
# CJ Affiliate — Personal Access Token.
# The full credential set is UNKNOWN: developers.cj.com is not publicly
# retrievable, so further identifiers may be required. Confirm in step 5.
# ---------------------------------------------------------------------------
CJ_PERSONAL_ACCESS_TOKEN=
CJ_PUBLISHER_ID=
CJ_API_BASE_URL=

# ---------------------------------------------------------------------------
# Contractual limits. These are NOT tuning knobs.
#
# COMMERCE_PROVIDER_CACHE_TTL_MAX_S must be set from the provider's written
# caching terms and becomes license_tag.cache_ttl_max_s. Choosing a number
# because it performs well would be asserting a licence we were not granted.
# ---------------------------------------------------------------------------
COMMERCE_PROVIDER_CACHE_TTL_MAX_S=

# Comma-separated approved merchant domains for the signed hand-off.
COMMERCE_MERCHANT_ALLOWLIST=
